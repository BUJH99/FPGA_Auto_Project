# Copy this file to telegram_fpga_bot.env and edit values.

# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=1234567890:REPLACE_ME

# Allowed Telegram user IDs (comma-separated)
TELEGRAM_ALLOWED_USER_IDS=123456789
# Optional: allow Telegram usernames too (comma-separated, with or without @)
# TELEGRAM_ALLOWED_USERNAMES=your_username

# Optional: restrict chat IDs too (comma-separated)
# TELEGRAM_ALLOWED_CHAT_IDS=123456789

# Optional secret file (default:
# ..\FPGA_AGENT_TOKEN\TELEGRAMTOKEN_ID.txt from the repo root;
# ..\MOBILE_AGENT_TOKEN\TELEGRAMTOKEN_ID.txt is also checked as a legacy fallback)
# TELEGRAM_SECRET_FILE=C:\Users\tbdk5\Desktop\MAIN\0_Working\git\FPGA_AGENT_TOKEN\TELEGRAMTOKEN_ID.txt
#
# Supported text formats include:
# API TOKEN : <token>
# ID : <numeric_user_id_or_username>

# Optional override. Defaults resolve from this repo's Telegram\ folder.
# FPGA_AUTOMATION_REPO_ROOT=C:\Users\tbdk5\Desktop\MAIN\0_Working\git\FPGA_Auto_Project
# FPGA_AUTOMATION_TEMPLATES_ROOT=C:\Users\tbdk5\Desktop\MAIN\0_Working\git\FPGA_Auto_Project\templates
# FPGA_MAIN_BAT_PATH=C:\Users\tbdk5\Desktop\MAIN\0_Working\git\FPGA_Auto_Project\MAIN.bat
# FPGA_PROJECT_ROOT=C:\Users\tbdk5\Desktop\MAIN\0_Working\git\FPGA_Auto_Project\Project

# Polling and execution controls
TELEGRAM_POLL_TIMEOUT_SEC=25
TELEGRAM_CMD_TIMEOUT_SEC=7200
TELEGRAM_SKIP_PENDING_UPDATES=1
TELEGRAM_AUTO_DELETE_WEBHOOK_ON_START=1
TELEGRAM_PROGRESS_INTERVAL_SEC=10

# Optional diagram artifact attachments (menus 1/3/8/9)
TELEGRAM_SEND_DIAGRAMS=1
TELEGRAM_MAX_DIAGRAM_FILES=3

# Optional menu 5(sim_vivado) replay log push
# 0 disables text excerpt
TELEGRAM_SIM_VIVADO_LOG_LINES=120
# 1 to attach full vivado_sim*.log as document
TELEGRAM_SIM_VIVADO_SEND_LOG_FILE=1
# 1: detect replay completion marker and auto-finish job (default)
TELEGRAM_SIM_VIVADO_AUTO_COMPLETE_ON_REPLAY=1
# replay marker check interval (seconds)
TELEGRAM_SIM_VIVADO_REPLAY_CHECK_SEC=5
