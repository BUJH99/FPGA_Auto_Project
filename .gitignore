# Ignore everything in the root directory
/*

# But exclude (allow) these files and directories
!/.gitignore
!/AGENTS.md
!/ReadMe.md
!/templates/
!/MAIN.bat
!/templates/vcd2sgv/
!/templates/vcd2sgv/**
!/tests/
!/tests/**
!/Telegram/
!/Telegram/**
!/setup_toolkit.bat
!SV_SUPPORT_MID_CHECK_2026-02-24.md
# Ignore local sync helper script
/SyncProjectsToSourceProject.bat

# Do not keep generated sample outputs in templates
/templates/output/**
!/templates/output/.gitkeep
/templates/node_modules/.cache/**

# Ignore retired/local Slidev integration artifacts
/templates/contexts/reporting/adapters/bat/report_open_slidev_viewer.bat
/templates/contexts/reporting/slidedev/
/templates/node_modules/.bin/slidev.cmd
/templates/node_modules/.cache/fpga_auto_slidev_runtime/
/templates/node_modules/@slidev/

# Ignore common OS files (just in case they end up in templates)
thumbs.db
desktop.ini
.DS_Store

# Ignore common FPGA/Editor files (doubly ensuring)
*.xpr
*.log
*.jou
*.str
*.pb
*.wdb
*.vcd
__pycache__/
*.pyc
