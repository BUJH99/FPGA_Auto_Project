<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Module Verification Presentation</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/@phosphor-icons/web"></script>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Pretendard:wght@300;400;500;600;700&display=swap');

    :root {
      --ui-scale: 1.25;
      font-size: calc(16px * var(--ui-scale));
    }

    html,
    body {
      margin: 0;
      padding: 0;
      width: 100%;
      height: 100%;
    }

    body {
      font-family: 'Pretendard', sans-serif;
      background-color: #f1f5f9;
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
      color: #334155;
    }

    #presentation-area {
      width: 1920px;
      height: 1080px;
      background-color: #ffffff;
      box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1);
      position: relative;
      overflow: hidden;
      border-radius: 8px;
    }

    #slide-container {
      width: 100%;
      height: 100%;
    }

    .slide {
      display: none;
      width: 100%;
      height: 100%;
      padding: calc(48px * var(--ui-scale)) calc(64px * var(--ui-scale));
      box-sizing: border-box;
      flex-direction: column;
      animation: fadeIn 0.3s ease-in-out;
    }

    .slide.active {
      display: flex;
    }

    .slide-header {
      border-bottom: 1px solid #e2e8f0;
      padding-bottom: calc(12px * var(--ui-scale));
      margin-bottom: calc(16px * var(--ui-scale));
    }

    .bg-pattern {
      background-image: radial-gradient(#cbd5e1 1px, transparent 1px);
      background-size: 24px 24px;
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(10px); }
      to { opacity: 1; transform: translateY(0); }
    }

    #controls {
      position: absolute;
      bottom: calc(24px * var(--ui-scale));
      right: calc(32px * var(--ui-scale));
      display: flex;
      align-items: center;
      gap: calc(16px * var(--ui-scale));
      color: #94a3b8;
      z-index: 50;
    }

    .nav-btn {
      background: none;
      border: none;
      cursor: pointer;
      color: #64748b;
      padding: calc(8px * var(--ui-scale));
      border-radius: 50%;
      transition: all 0.2s;
    }

    .nav-btn:hover {
      background-color: #f1f5f9;
      color: #0f172a;
    }

    .mono {
      font-family: Consolas, 'Courier New', monospace;
    }

    #presentation-area .text-\[10px\] { font-size: calc(10px * var(--ui-scale)) !important; }
    #presentation-area .text-\[11px\] { font-size: calc(11px * var(--ui-scale)) !important; }

    .thin-scroll {
      overflow-y: auto;
      padding-right: 6px;
    }

    .thin-scroll::-webkit-scrollbar {
      width: 8px;
    }

    .thin-scroll::-webkit-scrollbar-thumb {
      background: #cbd5e1;
      border-radius: 8px;
    }

    @media print {
      :root {
        --ui-scale: 1.25 !important;
        font-size: calc(16px * var(--ui-scale)) !important;
      }

      @page {
        size: 1920px 1080px;
        margin: 0;
      }

      body.pdf-export {
        background: #ffffff !important;
        display: block !important;
        width: 1920px !important;
        margin: 0 !important;
        min-height: auto !important;
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
      }

      body.pdf-export #controls {
        display: none !important;
      }

      body.pdf-export #presentation-area {
        width: 1920px !important;
        height: 1080px !important;
        overflow: visible !important;
      }

      body.pdf-export #slide-container {
        width: 100% !important;
        height: 100% !important;
      }

      body.pdf-export .slide {
        display: flex !important;
        width: 100% !important;
        height: 100% !important;
        margin: 0 !important;
        page-break-after: always !important;
        break-after: page !important;
        animation: none !important;
      }

      body.pdf-export .slide:last-child {
        page-break-after: auto !important;
        break-after: auto !important;
      }
    }
  </style>
</head>
<body>
  <div id="presentation-area">
    <div id="slide-container"></div>
    <div id="controls">
      <span id="slide-counter" class="font-mono text-sm font-semibold">1 / 1</span>
      <button class="nav-btn" onclick="savePdfSlides()" title="Save PDF"><i class="ph ph-file-pdf text-2xl"></i></button>
      <button class="nav-btn" onclick="prevSlide()" title="Previous (Left Arrow)"><i class="ph ph-caret-left text-2xl"></i></button>
      <button class="nav-btn" onclick="nextSlide()" title="Next (Right Arrow)"><i class="ph ph-caret-right text-2xl"></i></button>
    </div>
  </div>

  <script>
    const projectData = {{ project_data_json }};

    const asArray = (v) => (Array.isArray(v) ? v : []);
    const esc = (v) =>
      String(v ?? "")
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;");
    const escAttr = (v) =>
      String(v ?? "")
        .replaceAll("&", "&amp;")
        .replaceAll('"', "&quot;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;");

    const scoreTone = (value) => {
      const n = Number(value) || 0;
      if (n >= 100) return "green";
      if (n >= 90) return "blue";
      return "yellow";
    };

    const scenarioTone = (name) => {
      const map = {
        blue: "#3b82f6",
        green: "#22c55e",
        amber: "#f59e0b",
        yellow: "#f59e0b",
        purple: "#a855f7",
        teal: "#14b8a6",
        rose: "#f43f5e",
        red: "#ef4444",
        slate: "#64748b"
      };
      return map[String(name || "").toLowerCase()] || "#3b82f6";
    };

    const card = (title, body, cls = "") => `
      <div class="bg-white p-5 border border-slate-200 rounded-xl shadow-sm flex flex-col ${cls}">
        ${title ? `<h3 class="font-bold text-slate-800 mb-3 flex items-center gap-2">${title}</h3>` : ""}
        <div class="${title ? "flex-1 min-h-0 flex flex-col" : "min-h-0 flex flex-col"}">${body}</div>
      </div>
    `;

    const table = (headers, rows) => `
      <div class="bg-white border border-slate-200 rounded-xl shadow-sm overflow-auto h-full min-h-0">
        <table class="w-full text-sm text-left table-fixed">
          <thead class="bg-slate-50 text-slate-600 font-bold border-b border-slate-200">
            <tr>${headers.map((h) => `<th class="px-4 py-2 border border-slate-200 whitespace-normal break-words">${esc(h)}</th>`).join("")}</tr>
          </thead>
          <tbody>
            ${rows.map((row) => `<tr class="border-b border-slate-100 last:border-none">${row.map((c) => `<td class="px-4 py-2 border border-slate-200 whitespace-normal break-words">${c}</td>`).join("")}</tr>`).join("")}
          </tbody>
        </table>
      </div>
    `;

    const chips = (items, tone = "blue") => {
      if (!Array.isArray(items) || items.length === 0) return `<span class="text-xs text-slate-400">N/A</span>`;
      return items
        .map(
          (v) =>
            `<span class="inline-flex items-center px-2 py-1 rounded-md bg-${tone}-50 text-${tone}-700 border border-${tone}-200 text-[11px] mono">${esc(v)}</span>`
        )
        .join("");
    };

    const imageBox = (path, fallback, options = {}) => {
      const tight = Boolean(options && options.tight);
      const padClass = tight ? "p-0" : "p-2";
      const imgClass = tight
        ? "block w-auto h-auto max-w-full max-h-full object-contain object-center"
        : "block w-auto h-auto max-w-full max-h-full object-contain";
      if (!path) {
        return `<div class="h-full flex items-center justify-center rounded-xl border border-dashed border-slate-300 bg-slate-50 text-slate-500 text-sm">${esc(fallback)}</div>`;
      }
      return `
        <div class="w-full h-full min-h-0 rounded-xl border border-slate-200 bg-slate-50 ${padClass} overflow-hidden flex items-center justify-center">
          <img src="${esc(path)}" class="${imgClass}" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
          <div style="display:none" class="w-full h-full items-center justify-center text-slate-500 text-sm">${esc(fallback)}<br><span class="mono text-xs">${esc(path)}</span></div>
        </div>
      `;
    };

    const progressBars = (scores, overallIssues) => {
      const rows = asArray(scores).length > 0 ? asArray(scores) : [{ name: "overall", score: String(overallIssues || "").startsWith("0") ? 100 : 70 }];
      return `
        <div class="flex flex-col gap-3">
          ${rows
            .map((s) => {
              const p = Math.max(0, Math.min(100, Number(s.score) || 0));
              const tone = scoreTone(p);
              const checked = Number(s.checked) || 0;
              const errors = Number(s.errors) || 0;
              const status = String(s.status || (errors > 0 ? "FAIL" : checked > 0 ? "PASS" : "N/A")).toUpperCase();
              const reason = String(s.reason || "").trim();
              const summaryLine = `Status: ${status} | Checked: ${checked} | Errors: ${errors}${reason ? ` | Reason: ${reason}` : ""}`;
              return `
                <div class="rounded-lg border border-slate-200 p-2.5 bg-white">
                  <div class="flex items-center justify-between gap-3 text-sm font-semibold mb-1">
                    <div class="min-w-0 flex items-center gap-2">
                      <span class="mono text-slate-800 shrink-0">${esc(s.name)}</span>
                      <span class="text-[11px] text-slate-600 truncate">${esc(summaryLine)}</span>
                    </div>
                    <span class="text-${tone}-600 shrink-0">${p.toFixed(2)}%</span>
                  </div>
                  <div class="w-full bg-slate-100 rounded-full h-3"><div class="bg-${tone}-500 h-3 rounded-full" style="width:${p}%"></div></div>
                </div>
              `;
            })
            .join("")}
          <div class="pt-3 border-t border-slate-200 text-sm font-semibold">Overall Issues: <span class="${String(overallIssues || "").startsWith("0") ? "text-green-600" : "text-rose-600"}">${esc(overallIssues || "N/A")}</span></div>
        </div>
      `;
    };

    const slides = [];

    const pushSlide = (title, subtitle, body, extraClass = "", attrs = null) => {
      const header = title
        ? `<div class="slide-header"><h2 class="text-2xl font-bold text-slate-900">${esc(title)}</h2><p class="text-lg text-slate-500 mt-1">${esc(subtitle || "")}</p></div>`
        : "";
      const attrText =
        attrs && typeof attrs === "object"
          ? Object.entries(attrs)
              .filter(([, v]) => v !== undefined && v !== null && String(v) !== "")
              .map(([k, v]) => ` ${escAttr(k)}="${escAttr(v)}"`)
              .join("")
          : "";
      slides.push(`<div class="slide ${extraClass}"${attrText}>${header}<div class="flex-1 min-h-0 flex gap-6 w-full">${body}</div></div>`);
    };

    function buildIntro() {
      const meta = projectData.meta || {};
      const env = projectData.env || {};
      const modules = asArray(projectData.modules);

      pushSlide(
        "",
        "",
        `
        <div class="absolute inset-0 bg-white/85 z-0"></div>
        <div class="relative z-10 flex-1 flex flex-col items-center justify-center text-center w-full h-full">
          <div class="w-24 h-24 bg-blue-50 rounded-full flex items-center justify-center mb-8 shadow-sm"><i class="ph ph-cpu text-5xl text-blue-600"></i></div>
          <h1 class="text-6xl font-bold text-slate-900 mb-5">${esc(meta.title || "FPGA Module Verification")}</h1>
          <p class="text-2xl text-slate-500 mb-10">${esc(meta.subtitle || "")}</p>
          <div class="bg-white px-10 py-6 rounded-2xl shadow-sm border border-slate-100 text-lg text-slate-700 space-y-2">
            <p><strong>Author:</strong> ${esc(meta.author || "-")}</p>
            <p><strong>Date:</strong> ${esc(meta.date || "-")}</p>
            <p><strong>Top:</strong> ${esc(env.top || "-")}</p>
          </div>
        </div>
      `,
        "bg-pattern relative"
      );

      pushSlide(
        "Table of Contents",
        "Intro -> Module Spec -> Verification -> Outro",
        `
        <div class="w-full min-w-0">
          <div class="flex flex-col gap-6 px-10 justify-center h-full">
            <div class="flex items-center gap-6 p-4 rounded-xl hover:bg-slate-50 transition">
              <div class="w-16 h-16 rounded-full bg-blue-100 flex items-center justify-center text-blue-600 text-2xl font-bold">1</div>
              <div><h3 class="text-2xl font-semibold text-slate-800">Overview</h3></div>
            </div>
            <div class="flex items-center gap-6 p-4 rounded-xl hover:bg-slate-50 transition">
              <div class="w-16 h-16 rounded-full bg-blue-100 flex items-center justify-center text-blue-600 text-2xl font-bold">2</div>
              <div><h3 class="text-2xl font-semibold text-slate-800">Environment</h3></div>
            </div>
            <div class="flex items-center gap-6 p-4 rounded-xl bg-blue-50 shadow-sm border border-blue-100">
              <div class="w-16 h-16 rounded-full bg-blue-600 flex items-center justify-center text-white text-2xl font-bold">3</div>
              <div><h3 class="text-2xl font-bold text-blue-900">Module SPEC & Verification</h3></div>
            </div>
            <div class="flex items-center gap-6 p-4 rounded-xl hover:bg-slate-50 transition">
              <div class="w-16 h-16 rounded-full bg-blue-100 flex items-center justify-center text-blue-600 text-2xl font-bold">4</div>
              <div><h3 class="text-2xl font-semibold text-slate-800">Trouble / Conclusion</h3></div>
            </div>
          </div>
        </div>
      `
      );

      pushSlide(
        "Environment",
        "Project runtime context",
        `
        <div class="w-full h-full flex flex-col gap-6">
          <div class="flex-1 min-h-0 flex gap-6">
            <div class="w-1/2 min-h-0">${card("<i class='ph ph-desktop text-blue-500'></i> Environment", `
              <ul class="space-y-4 text-slate-700">
                <li class="flex flex-col"><span class="text-sm text-slate-400 font-semibold mb-1">OS</span><span class="bg-slate-50 px-3 py-2 rounded border border-slate-100">Windows11</span></li>
                <li class="flex flex-col"><span class="text-sm text-slate-400 font-semibold mb-1">Tool / Language</span><span class="bg-slate-50 px-3 py-2 rounded border border-slate-100">${esc(env.tools || "-")}</span></li>
              </ul>
            `, "h-full")}</div>
            <div class="w-1/2 min-h-0">
              <div class="bg-white border border-slate-200 rounded-xl p-6 shadow-sm flex flex-col justify-center items-center text-center h-full">
                <div class="flex items-center gap-3 mb-4"><i class="ph ph-circuitry text-4xl text-green-500"></i><h3 class="text-2xl font-bold">Board</h3></div>
                <div class="bg-green-50 text-green-800 text-xl font-bold py-6 px-8 rounded-lg border border-green-200 w-full">Basys3</div>
              </div>
            </div>
          </div>
          <div class="flex-1 min-h-0">${card("<i class='ph ph-users text-purple-500'></i> Roles", `
            <div class="grid grid-cols-2 gap-6">
              <div class="p-4 bg-purple-50 rounded-lg border border-purple-100 flex items-start gap-4">
                <div class="w-12 h-12 bg-white rounded-full flex items-center justify-center text-purple-500 font-bold shadow-sm shrink-0">1</div>
                <div><h4 class="font-bold text-slate-800">Generator</h4><p class="text-sm text-slate-600 mt-1">RTL/TB scan, scaffold mapping, artifact parsing</p></div>
              </div>
              <div class="p-4 bg-purple-50 rounded-lg border border-purple-100 flex items-start gap-4">
                <div class="w-12 h-12 bg-white rounded-full flex items-center justify-center text-purple-500 font-bold shadow-sm shrink-0">2</div>
                <div><h4 class="font-bold text-slate-800">Presentation</h4><p class="text-sm text-slate-600 mt-1">Template rendering, visualized verification report</p></div>
              </div>
            </div>
          `, "h-full")}</div>
        </div>
      `
      );

      const topModule =
        modules.find((m) => String(m.type || "").toLowerCase() === "top") ||
        modules[0] ||
        null;
      const topDetailedPath = topModule
        ? ((topModule.assets && topModule.assets.detailedDiagramSvg) ||
           `../output/Diagram/Detailed/${topModule.name}_detailed.svg`)
        : "";

      pushSlide(
        "Top Detailed Flow",
        "Top Detailed.svg",
        `
        <div class="w-full min-h-0">
          ${card(
            topModule ? `${esc(topModule.name)} Detailed Diagram` : "Top Detailed Diagram",
            imageBox(
              topDetailedPath,
              topModule
                ? `${topModule.name} detailed diagram not found`
                : "Top module not found",
              { tight: true }
            ),
            "h-full min-h-0"
          )}
        </div>
      `
      );
    }

    function buildModuleSpec(m, idx) {
      const rawIoPorts = asArray(m.ioPorts);
      const sortedIoPorts = rawIoPorts
        .map((p, i) => ({ p, i }))
        .sort((a, b) => {
          const rank = { input: 0, output: 1, inout: 2 };
          const ra = rank[String(a.p?.dir || "").toLowerCase()] ?? 9;
          const rb = rank[String(b.p?.dir || "").toLowerCase()] ?? 9;
          if (ra !== rb) return ra - rb;
          return a.i - b.i;
        })
        .map((x) => x.p);

      const widthToBits = (w) => {
        const raw = String(w || "").trim();
        if (!raw || raw === "1") return 1;
        const colon = raw.match(/^\[\s*(-?\d+)\s*:\s*(-?\d+)\s*\]$/);
        if (colon) {
          const msb = Number(colon[1]);
          const lsb = Number(colon[2]);
          if (Number.isFinite(msb) && Number.isFinite(lsb)) return Math.abs(msb - lsb) + 1;
        }
        const single = raw.match(/^\[\s*(\d+)\s*\]$/);
        if (single) {
          const n = Number(single[1]);
          if (Number.isFinite(n)) return n + 1;
        }
        const justNum = raw.match(/^(\d+)$/);
        if (justNum) return Number(justNum[1]) || 1;
        return 1;
      };

      const rawInternals = asArray(m.internalSignals);
      const internals = rawInternals.map((s) => [
        `<span class="mono text-blue-700">${esc(s.name || "-")}</span>`,
        esc(s.type || "-"),
        esc(s.purpose || "-")
      ]);

      const hierarchyNodes = asArray(m.hierarchy);
      const childNames = hierarchyNodes.map((h) => h.name || "").filter(Boolean);
      const fsm = asArray(m.fsmStates);
      const assets = m.assets || {};
      const dirCounts = rawIoPorts.reduce(
        (acc, p) => {
          const key = String(p?.dir || "").toLowerCase();
          if (key === "input") acc.input += 1;
          else if (key === "output") acc.output += 1;
          else if (key === "inout") acc.inout += 1;
          return acc;
        },
        { input: 0, output: 0, inout: 0 }
      );
      const maxIoWidth = rawIoPorts.reduce((acc, p) => Math.max(acc, widthToBits(p?.width)), 1);
      const busPorts = sortedIoPorts.filter((p) => widthToBits(p?.width) > 1);
      const inferActiveLevel = (name) => {
        const n = String(name || "").toLowerCase();
        const lowHit =
          /^n(?:clk|clock|rst|reset)/.test(n) ||
          /(rst_n|reset_n|clk_n|clock_n|nrst|nreset|nclk|nclock)/.test(n) ||
          /(clk|clock|rst|reset)(?:_n|n|_b|_bar|_l|_low)$/.test(n);
        return lowHit ? "active-low" : "active-high";
      };
      const inferClockFreq = (name) => {
        const n = String(name || "").toLowerCase();
        let m = n.match(/(\d+(?:\.\d+)?)\s*(ghz|mhz|khz|hz)\b/);
        if (m) return `${m[1]}${m[2].toUpperCase()}`;
        m = n.match(/(\d+(?:\.\d+)?)(g|m|k)(?![a-z])/);
        if (m) {
          const unitMap = { g: "GHz", m: "MHz", k: "kHz" };
          return `${m[1]}${unitMap[m[2]] || ""}`;
        }
        return "N/A";
      };
      const clockPortsMeta = sortedIoPorts
        .filter((p) => /(clk|clock)/i.test(String(p?.name || "")))
        .map((p) => ({
          name: p.name || "-",
          freq: inferClockFreq(p?.name),
        }))
        .slice(0, 6);
      const resetPortsMeta = sortedIoPorts
        .filter((p) => /(rst|reset)/i.test(String(p?.name || "")))
        .map((p) => ({
          name: p.name || "-",
          active: inferActiveLevel(p?.name),
        }))
        .slice(0, 6);
      const clockPrimary = clockPortsMeta[0] || { name: "No clock port", freq: "-" };
      const resetPrimary = resetPortsMeta[0] || { name: "No reset port", active: "-" };
      const clockExtraCount = Math.max(clockPortsMeta.length - 1, 0);
      const resetExtraCount = Math.max(resetPortsMeta.length - 1, 0);
      // Resolve display frequency: use clkFreqLabel from Python if port-name parse gives N/A
      const clkFreqDisplay = (clockPrimary.freq && clockPrimary.freq !== "N/A")
        ? clockPrimary.freq
        : (m.clkFreqLabel || "N/A");
      const handshakePorts = sortedIoPorts
        .filter((p) => /(valid|ready|ack|req|en|done|cmd|mode)/i.test(String(p?.name || "")))
        .map((p) => p.name);
      // widest bus port info for Data Buses badge
      const widestBusPort = busPorts.reduce((best, p) => {
        return (!best || widthToBits(p?.width) > widthToBits(best?.width)) ? p : best;
      }, null);
      const widestBusLabel = widestBusPort ? `${widestBusPort.name} ${widestBusPort.width || ""}`.trim() : "-";
      const internalTypeCounts = rawInternals.reduce(
        (acc, s) => {
          const key = String(s?.type || "").toLowerCase();
          if (key === "wire") acc.wire += 1;
          else if (key === "reg") acc.reg += 1;
          else if (key === "logic") acc.logic += 1;
          else acc.other += 1;
          return acc;
        },
        { wire: 0, reg: 0, logic: 0, other: 0 }
      );
      const specKind = String(
        m.specKind ||
          (hierarchy.length ? "type1" : (fsm.length ? "type3" : "type2"))
      ).toLowerCase();
      const specAttrs = (page) => ({
        "data-module": m.name || `module-${idx}`,
        "data-spec-kind": specKind,
        "data-spec-page": String(page)
      });
      const specTitle = `3.${idx}. ${m.name} Source SPEC`;

      pushSlide(
        specTitle,
        "Overview & I/O",
        `
        <div class="w-1/2 min-h-0 flex flex-col gap-4">
          <div class="h-[58%] min-h-0">
            ${card(
              "Module Diagram",
              `<div class="flex-1 min-h-0">${imageBox(assets.simpleDiagramSvg || "", "Simple diagram not found", { tight: true })}</div>`,
              "h-full min-h-0 flex flex-col"
            )}
          </div>
