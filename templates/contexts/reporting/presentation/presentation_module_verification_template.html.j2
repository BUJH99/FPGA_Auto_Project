            <div class="p-3 rounded border border-slate-200 bg-slate-50"><strong>Modules:</strong> ${asArray(projectData.modules).length}</div>
            <div class="p-3 rounded border border-slate-200 bg-slate-50"><strong>Date:</strong> ${esc((projectData.meta || {}).date || "-")}</div>
